<Window x:Class="StealthAssistWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StealthAssistWPF"
        mc:Ignorable="d"
        Title="Yok-AI" 
        Height="650" Width="500"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="#FF202020"
        BorderThickness="0"
        BorderBrush="#FF303030"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MinWidth="10" MinHeight="10"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    
    
    <Border x:Name="MainBorder" 
            Background="{StaticResource BackgroundDarkBrush}" 
            CornerRadius="8"
            BorderBrush="{StaticResource BorderDarkBrush}"
            BorderThickness="0">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Shortcuts Panel -->
                <RowDefinition Height="Auto"/>
                <!-- Control Panel -->
                <RowDefinition Height="Auto"/>
                <!-- Voice Capture Panel -->
                <RowDefinition Height="*"/>
                <!-- Chat History -->
                <RowDefinition Height="Auto"/>
                <!-- Thumbnail Panel -->
                <RowDefinition Height="Auto"/>
                <!-- Input Area -->
                <RowDefinition Height="Auto"/>
                <!-- Status Bar -->
            </Grid.RowDefinitions>
            
            <!-- Login Panel -->
            <Grid x:Name="LoginGrid" Visibility="Visible" Panel.ZIndex="999" Grid.RowSpan="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" 
            MouseDown="TitleBar_MouseDown" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                            <Image Width="18" Height="18" Source="/Resources/32x32.ico">
                                <Image.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#0078D7" Opacity="0.7"/>
                                </Image.Effect>
                            </Image>

                            <TextBlock Text="Yok-AI: Settings" FontWeight="Medium" Margin="8,0,0,0" 
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Button x:Name="CloseLoginButton" Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="20" Height="20"
                    Content="×" Foreground="{StaticResource TextPrimaryBrush}"
                    Click="CloseSettingsButton_Click" Margin="0,0,15,0"/>
                    </Grid>
                </Border>

                <!-- Main Content - Made responsive -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Login Form - Responsive -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid VerticalAlignment="Center">
                            <Border Background="{StaticResource BackgroundLightBrush}" 
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="25,30" 
                        Margin="50,0,50,40"
                        MaxWidth="350">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type TextBox}">
                                            <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Height" Value="34"/>
                                            <Setter Property="Margin" Value="0,0,0,12"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="{x:Type PasswordBox}">
                                            <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Height" Value="34"/>
                                            <Setter Property="Margin" Value="0,0,0,12"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </Style>
                                    </StackPanel.Resources>

                                    <TextBlock Text="AI provider" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ProviderComboBox" Height="34" Margin="0,0,0,12" FontSize="13"
                                              SelectionChanged="ProviderComboBox_SelectionChanged"/>

                                    <TextBlock x:Name="ApiKeyLabel" Text="API key" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="ApiKeyBox" Cursor="Arrow"/>

                                    <TextBlock x:Name="BaseUrlLabel" Text="Server address (Base URL)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BaseUrlTextBox" Cursor="Arrow"/>

                                    <TextBlock Text="Model (leave empty for the default)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ModelTextBox" Cursor="Arrow"/>

                                    <TextBlock Text="Azure Speech key (optional: leave empty to use free, offline Windows speech)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                    <PasswordBox x:Name="AzureKeyBox" Cursor="Arrow"/>

                                    <TextBlock Text="Azure Speech region (only with an Azure key)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AzureRegionTextBox" Cursor="Arrow"/>

                                    <TextBlock x:Name="ProviderHintText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <!-- Status Text -->
                                    <TextBlock x:Name="LoginStatusText" Foreground="{StaticResource WarningRedBrush}" 
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,25" 
                                   FontSize="14" Height="30" Visibility="Collapsed"/>

                                    <!-- Login Button -->
                                    <Button x:Name="LoginButton" Content="SAVE" 
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="Bold"
                                Height="45" 
                                MinWidth="170"
                                MaxWidth="250"
                                Click="LoginButton_Click"
                                HorizontalAlignment="Center">
                                        <Button.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="22">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBlueDarkBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBlueDarkBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Height="30">
                    <Grid>
                        <TextBlock x:Name="LoginVersionText" Text="v1.0" FontSize="11" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Header Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="10,8">
                    <Image Width="18" Height="18" Source="/Resources/32x32.ico">
                        <Image.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#0078D7" Opacity="0.7"/>
                        </Image.Effect>
                    </Image>

                    <TextBlock Text="Yok-AI: The Private AI Assistant" FontWeight="Medium" Margin="8,0,0,0" 
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Border Background="#333333" CornerRadius="10" Margin="10,0,0,0" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="Active" FontSize="10" Foreground="#A3E9A4"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ContextActiveIndicator" 
                            Background="#333333" CornerRadius="10" 
                            Margin="10,0,0,0" Padding="8,2"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="10" Margin="0,0,5,0"/>
                            <TextBlock Text="Context Active" FontSize="10" Foreground="#A3E9A4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,5,10,5">
                    <Button x:Name="ContextButton" Width="20" Height="20" Margin="0,0,5,0"
                            Background="Transparent" BorderThickness="0" 
                            Content="📋" Foreground="{StaticResource TextSecondaryBrush}"
                            Click="ContextButton_Click" ToolTip="Set Meeting Context"
                            Cursor="Arrow"/>
                    
                    <!-- Add this after the ContextButton in the header StackPanel -->
                    <Button x:Name="MemoryToggleButton" Width="20" Height="20" Margin="0,0,5,0"
                            Background="Transparent" BorderThickness="0" 
                            Content="🧠" Foreground="{StaticResource TextSecondaryBrush}"
                            Click="MemoryToggleButton_Click" ToolTip="Toggle Chat Memory"
                            Cursor="Arrow"/>
                    
                    <Button x:Name="HelpButton" Width="20" Height="20" Margin="0,0,5,0"
                            Background="Transparent" BorderThickness="0" 
                            Content="?" Foreground="{StaticResource TextSecondaryBrush}"
                            Click="HelpButton_Click" ToolTip="Show Keyboard Shortcuts"
                            Cursor="Arrow"/>

                    <Button x:Name="MinimizeButton" Width="20" Height="20" Margin="0,0,5,0"
                            Background="Transparent" BorderThickness="0" 
                            Content="−" Foreground="{StaticResource TextSecondaryBrush}"
                            Click="MinimizeButton_Click"
                            Cursor="Arrow"/>

                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Width="20" Height="20"
                            Content="×" Foreground="{StaticResource TextPrimaryBrush}"
                            Click="CloseButton_Click"
                            Cursor="Arrow"/>
                </StackPanel>
            </Grid>

            <!-- Shortcuts Help Panel -->
            <Border x:Name="ShortcutsPanel" Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" 
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
                    Visibility="Collapsed" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="Keyboard Shortcuts" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" 
                               Margin="0,0,0,5" FontSize="12"/>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,2,5,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+Space" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Show / Hide" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,2,5,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+C" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Screenshot" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Margin="0,2,5,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+M" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Start multi-shot" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="0" Margin="0,2,5,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+F" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Finish multi-shot" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Margin="5,2,0,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+X" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Emergency Exit" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Margin="5,2,0,2" Background="#222222" Padding="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl+Alt+K" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Hide Keystrokes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Replace the entire MeetingContextPanel with this code -->
            <Border x:Name="MeetingContextPanel" Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" 
              BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
              Visibility="Collapsed" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Row 0: Title -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: Audio prompt label -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: Audio prompt input -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 3: Screenshot prompt label -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 4: Screenshot prompt input -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 5: Selection prompt label -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 6: Selection prompt input -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 7: Buttons -->
                            </Grid.RowDefinitions>

                    <!-- Title (Row 0) -->
                            <TextBlock Text="Default Prompts" Grid.Row="0" FontWeight="SemiBold" 
                           Foreground="{StaticResource AccentBlueBrush}" 
                           Margin="0,0,0,8" FontSize="12"/>

                            <!-- Audio Prompt Label (Row 1) -->
                            <TextBlock Text="Default prompt for transcribed messages:" 
                           Grid.Row="1"
                           FontSize="11" Margin="0,0,0,5" 
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Audio Prompt Input (Row 2) -->
                            <TextBox x:Name="AudioPromptTextBox" 
                             Grid.Row="2"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="80" 
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" 
                             Margin="0,0,0,10"
                             FontSize="11"
                             Cursor="Arrow"/>

                            <!-- Screenshot Prompt Label (Row 3) -->
                            <TextBlock Text="Default prompt for screenshot messages:" 
                           Grid.Row="3"
                           FontSize="11" Margin="0,0,0,5" 
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Screenshot Prompt Input (Row 4) -->
                            <TextBox x:Name="ScreenshotPromptTextBox" 
                             Grid.Row="4"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="80" 
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" 
                             Margin="0,0,0,10"
                             FontSize="11"
                             Cursor="Arrow"/>

                    <!-- Selection Prompt Label (Row 5) -->
                    <TextBlock Text="Default prompt for manually selected text:" 
                       Grid.Row="5"
                       FontSize="11" Margin="0,0,0,5" 
                       Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- Selection Prompt Input (Row 6) -->
                    <TextBox x:Name="SelectionPromptTextBox" 
                        Grid.Row="6"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Height="80" 
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto" 
                        Margin="0,0,0,10"
                        FontSize="11"
                        Cursor="Arrow"/>
                            
                    <!-- Buttons (Row 7) -->
                            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CancelContextButton" 
                            Content="Cancel" 
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="10,3" 
                            Margin="0,0,5,0"
                            FontSize="11"
                            Click="CancelContextButton_Click"
                                        Cursor="Arrow"/>

                                <Button x:Name="SaveContextButton" 
                            Content="Save Settings" 
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource AccentBlueBrush}"
                            Padding="10,3" 
                            FontSize="11"
                            Click="SaveContextButton_Click"
                                        Cursor="Arrow"/>
                            </StackPanel>
                        </Grid>
                    </Border>
            <!-- Control Panel - Empty for now -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" 
                 Padding="0" Height="0" Visibility="Collapsed">
            </Border>

            <!-- NEW: Always-visible Real-time Transcription Panel -->
            <Border x:Name="RealtimeTranscriptionPanel" Grid.Row="3" Background="#1A1A2E" 
        BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
        Visibility="Visible" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Enhanced Header with Toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left side: Title and Status -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Live Meeting Transcription" FontSize="14" FontWeight="SemiBold" 
                          Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,15,0"/>

                            <!-- Status Indicator -->
                            <Border x:Name="TranscriptionStatusIndicator" Background="#333333" 
                        CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TranscriptionStatusDot" Width="8" Height="8" 
                                Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TranscriptionStatusText" Text="Disabled" 
                                  FontSize="11" Foreground="#B3B3B3"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" 
                           Margin="15,0">
                                            <TextBlock x:Name="TranscriptionWordCountLabel" Text="0 words" FontSize="12" 
                              Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Right side: Toggle Switch -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Border x:Name="ToggleBackground" Background="#404040" 
                                CornerRadius="15" Width="50" Height="30" 
                                BorderBrush="#555555" BorderThickness="1"
                                Cursor="Arrow" MouseLeftButtonDown="TranscriptionToggle_Click">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" 
                                         Opacity="0.3" Color="Black"/>
                                </Border.Effect>
                            </Border>

                            <!-- Toggle Slider -->
                            <Ellipse x:Name="ToggleSlider" Width="22" Height="22" 
                            Fill="#666666" HorizontalAlignment="Left" 
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            Cursor="Arrow" MouseLeftButtonDown="TranscriptionToggle_Click">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" 
                                         Opacity="0.4" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Toggle Icon -->
                            <TextBlock x:Name="ToggleIcon" Text="🎤" FontSize="10" 
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="8,0,0,0" Foreground="#999999"
                              Cursor="Arrow" MouseLeftButtonDown="TranscriptionToggle_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Transcription Display with Overlay -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <!-- Background ScrollViewer with Custom Scrollbar -->
                        <ScrollViewer x:Name="TranscriptionScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              Height="140" 
                              Background="#0F0F23"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.PanningMode="VerticalOnly"
                              ScrollViewer.PanningDeceleration="0.1"
                              ScrollViewer.PanningRatio="0.5">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                            </ScrollViewer.Resources>

                            <RichTextBox x:Name="RealtimeTranscriptionDisplay" 
                                Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsDocumentEnabled="True"
                                FontFamily="Segoe UI"
                                FontSize="11"
                                Padding="12"
                                Cursor="Arrow">
                                <RichTextBox.Resources>
                                    <Style TargetType="{x:Type Paragraph}">
                                        <Setter Property="Margin" Value="0,3"/>
                                    </Style>
                                </RichTextBox.Resources>
                                <FlowDocument>
                                    <Paragraph>
                                        <Run Text="Live transcription ready..." 
                         Foreground="#666666" FontStyle="Italic"/>
                                    </Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </ScrollViewer>
                        

                        <!-- Disabled Overlay -->
                        <Border x:Name="DisabledOverlay" Background="#000000" 
                    Opacity="0.7" Visibility="Visible">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎤" FontSize="24" Foreground="#555555" 
                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Transcription Disabled" FontSize="14" 
                                  Foreground="#888888" HorizontalAlignment="Center"
                                  FontWeight="Medium"/>
                                    <TextBlock Text="Click toggle to enable" FontSize="11" 
                                  Foreground="#666666" HorizontalAlignment="Center"
                                  Margin="0,4,0,0" FontStyle="Italic"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Simplified Controls - Remove Clear and Send to AI buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left side: Status info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock x:Name="StreamingStatusText" Text="Ready" FontSize="11" 
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right side: Stylish export button -->
                        <Button x:Name="ExportTranscriptionButton" 
                            Grid.Column="1"
                            Style="{StaticResource StylishExportButtonStyle}"
                            Click="ExportTranscriptionButton_Click"
                            ToolTip="Export Full Recording"
                            VerticalAlignment="Center"
                            Cursor="Arrow">
                            <TextBlock Text="⬇️" FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Chat History Area -->
            <!-- Chat History Area with Bubbles -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="4" 
              Background="{StaticResource BackgroundDarkBrush}"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Padding="8"
              Cursor="Arrow">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>

                    <!-- Message Text Style -->
                    <Style x:Key="BubbleTextStyle" TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="LineHeight" Value="16"/>
                    </Style>

                    <!-- Sender Label Style -->
                    <Style x:Key="SenderLabelStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Opacity" Value="0.8"/>
                    </Style>

                </ScrollViewer.Resources>

                <StackPanel x:Name="ChatBubbleContainer" Margin="0">
                    <!-- Welcome message bubble -->
                    <Border Style="{StaticResource SystemBubbleStyle}">
                        <TextBlock Text="Welcome to Yok-AI! How can I help you today?" 
                       Style="{StaticResource BubbleTextStyle}"
                       Foreground="{StaticResource AccentBlueBrush}"
                       TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Input Area -->
            <Border Grid.Row="6" Background="{StaticResource BackgroundMediumBrush}" Padding="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Reply Context Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Thumbnail Preview Area -->
                        <RowDefinition Height="*"/>
                        <!-- Input Area -->
                    </Grid.RowDefinitions>
                    <!-- Reply Context Bar (Hidden by default) -->
                    <Border x:Name="ReplyContextBar" Grid.Row="0" 
                Background="{StaticResource BackgroundLightBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="4,4,0,0"
                Padding="12,8"
                Margin="0,0,0,0"
                Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Reply Icon and Label -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Replying to:" FontSize="11" 
                               Foreground="{StaticResource AccentBlueBrush}" 
                               FontWeight="Medium"/>
                            </StackPanel>

                            <!-- Message Preview -->
                            <TextBlock x:Name="ReplyPreviewText" Grid.Column="1" 
                           FontSize="11" Margin="8,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                            <!-- Close Button -->
                            <Button x:Name="CloseReplyButton" Grid.Column="2" 
                        Style="{StaticResource CloseButtonStyle}" 
                        Width="16" Height="16"
                        Content="×" FontSize="10"
                        Click="CloseReplyButton_Click"
                        Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Main Input Grid -->
                    <!-- Replace existing ThumbnailPreviewArea with this enhanced version -->
                    <Border x:Name="ThumbnailPreviewArea" Grid.Row="5" 
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed"
                        Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnails ScrollViewer -->
                            <ScrollViewer x:Name="ThumbnailScrollViewer" 
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Height="80">
                                <StackPanel x:Name="ThumbnailContainer" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Left"/>
                            </ScrollViewer>

                            <!-- Clear All Button -->
                            <Button x:Name="ClearAllScreenshotsButton" 
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}" 
                            Width="24" Height="24"
                            Content="×" 
                            ToolTip="Clear all screenshots"
                            Click="ClearAllScreenshotsButton_Click"
                            VerticalAlignment="Top"
                            Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Main Input Grid -->
                    <Grid Grid.Row="1" x:Name="MainInputContainer">
                        <!-- Normal Input Mode -->
                        <Grid x:Name="NormalInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInput" 
                 Style="{StaticResource ModernTextBoxStyle}"
                 Height="50"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 PreviewKeyDown="UserInput_PreviewKeyDown"
                 Cursor="Arrow"/>

                            <!-- Button Stack Container -->
                            <StackPanel Grid.Column="1" 
                    Orientation="Vertical" 
                    Margin="5,0,0,0"
                    VerticalAlignment="Center">

                                <!-- Screenshot Button -->
                                <Button x:Name="ScreenshotButton" 
                                    Style="{StaticResource CircleButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,0,5"
                                    Click="ScreenshotButton_Click"
                                    ToolTip="Capture Screenshot"
                                    Background="#FF6B46C1">
                                                                <TextBlock Text="📷" 
                                           FontWeight="Bold" 
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-1,0,0"/>
                                </Button>
                                
                                <!-- Send Button -->
                                <Button x:Name="SendButton" 
                    Style="{StaticResource CircleButtonStyle}"
                    Width="30"
                    Height="30"
                    Click="SendButton_Click"
                    ToolTip="Send Message">
                                    <TextBlock Text="➤" FontWeight="Bold"/>
                                </Button>
                                
                            </StackPanel>
                        </Grid>
                        <!-- Remove the entire ScreenshotModeGrid -->
                        <Grid x:Name="ScreenshotModeGrid" Visibility="Collapsed">
                            <!-- Remove all content inside -->
                        </Grid>
                    </Grid>
                
                </Grid>
            </Border>
            
            <!-- Status Bar -->
            <Border Grid.Row="7" Background="{StaticResource BackgroundMediumBrush}" 
        BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0"
        Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Credits Counter - Replacing the three previous counters -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI:" 
                   FontSize="10" 
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,5,0"/>
                            <TextBlock x:Name="CreditsLabel" Cursor="Hand" ToolTip="Click to open Settings" MouseLeftButtonUp="CreditsLabel_MouseLeftButtonUp" 
                   Text="--" 
                   FontSize="10" 
                   Foreground="{StaticResource AccentBlueBrush}"
                   FontWeight="Medium"
                   Margin="0,0,5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Border>
</Window>